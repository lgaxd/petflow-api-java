JWT_MAX_SESSION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173
TEST_TUTOR_EMAIL=tutor@example.invalid
TEST_TUTOR_PASSWORD=replace-with-seed-tutor-password
