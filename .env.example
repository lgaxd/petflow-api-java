DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USERNAME=petflow_user
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
